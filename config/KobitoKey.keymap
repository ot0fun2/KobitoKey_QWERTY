#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <11 12>;
            bindings = <&kp TAB>;
        };

        combo_shifttab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp LS(TAB)>;
        };

        combo_kakko1 {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kakko>;
        };

        combo_kakko2 {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&Kakko2>;
        };

        combo_kakko3 {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&Kakko3>;
        };
    };

    macros {
        kakko: kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT &kp NUHS &kp LEFT>;
            label = "NEW_MACRO";
        };

        Kakko2: Kakko2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "KAKKO2";
        };

        Sinwa_mail: Sinwa_mail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp MINUS &kp S &kp A &kp T &kp O &kp AT &kp S &kp I &kp N &kp W &kp A &kp DOT &kp J &kp P>;
            label = "SINWA_MAIL";
        };

        Mymail: Mymail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp T &kp N0 &kp DOT &kp F &kp U &kp N &kp DOT &kp N2 &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "MYMAIL";
        };

        Kakko3: Kakko3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp GREATER_THAN &kp LEFT>;
            label = "KAKKO3";
        };

        rrmmdd: rrmmdd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp INT_HENKAN>,
                <&macro_tap>,
                <&kp R>,
                <&macro_release>,
                <&kp INT_HENKAN>;

            label = "REIWA";
        };

        ddmm: ddmm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp INT_HENKAN>,
                <&macro_tap>,
                <&kp T>,
                <&macro_release>,
                <&kp INT_HENKAN>;

            label = "DDMM";
        };

        kakeru: kakeru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp INT_HENKAN>,
                <&macro_tap>,
                <&kp K>,
                <&macro_release>,
                <&kp INT_HENKAN>;

            label = "KAKERU";
        };
    };

    behaviors {
        At_and: At_and {
            compatible = "zmk,behavior-tap-dance";
            label = "AT_AND";
            #binding-cells = <0>;
            bindings = <&kp AT>, <&kp AMPERSAND>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E        &kp R        &kp T          &kp Y     &kp U        &kp I      &kp O      &kp MINUS
&kp A      &kp S         &kp D        &kp F        &kp G          &kp H     &kp J        &kp K      &kp L      &kp P
&kp Z      &kp X         &kp C        &kp V        &kp B          &kp N     &kp M        &kp COMMA  &kp DOT    &kp SEMI
&kp LSHFT  &kp LEFT_GUI  &lt 4 LCTRL  &lt 1 SPACE  &mt LCTRL ESC  &kp BSPC  &lt 2 ENTER  &kp DEL    &kp RSHFT  &mt LALT SLASH
            >;
        };

        NUMBER {
            label = "NUMBER";
            bindings = <
&kp LC(HOME)     &kp HOME          &kp UP    &kp END            &kp LC(END)        &kp COLON       &kp N7          &kp N8        &kp N9        &kp KP_MULTIPLY
&kp PAGE_UP      &kp LEFT          &kp DOWN  &kp RIGHT          &kp PAGE_DOWN      &kp UNDERSCORE  &kp NUMBER_4    &kp N5        &kp NUMBER_6  &kp KP_DIVIDE
&kp LC(PAGE_UP)  &kp LC(LG(LEFT))  &none     &kp LC(LG(RIGHT))  &kp LC(PAGE_DOWN)  &kp MINUS       &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp KP_DOT
&kp LSHFT        &none             &none     &none              &none              &trans          &kp LS(INT_RO)  &kp N0        &kp PERIOD    &kakeru
            >;
        };

        Fn-BLE {
            label = "FUNCTION";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp F1   &kp F2   &kp F3    &kp F4           &kp F5
&none         &none         &none         &none         &bt BT_CLR      &kp F6   &kp F7   &kp F8    &kp F9           &kp F10
&none         &none         &none         &none         &bt BT_CLR_ALL  &kp F11  &kp F12  &kp RBKT  &kp NON_US_HASH  &none
&none         &none         &none         &none         &none           &kp DEL  &none    &none     &none            &none
            >;
        };

        MOUSE {
            label = "MOUSE";
            bindings = <
&none      &none  &none       &none     &none  &kp LC(C)  &mkp MB1   &mkp MB3  &mkp MB2   &kp KP_ENTER
&none      &none  &none       &none     &none  &kp LC(P)  &kp LCTRL  &none     &kp LC(A)  &kp DEL
&none      &none  &none       &none     &none  &none      &none      &none     &none      &none
&kp LSHFT  &none  &kp LSHIFT  &kp LALT  &to 0  &none      &none      &none     &none      &kp RALT
            >;
        };

        KIGOU {
            bindings = <
&none     &none     &none      &rrmmdd        &ddmm  &none  &none            &none  &none  &none
&kp LBKT  &kp HASH  &kp SLASH  &kp LG(LS(S))  &none  &none  &kp LC(LS(ESC))  &none  &none  &kp PERCENT
&none     &none     &none      &none          &none  &none  &none            &none  &none  &none
&none     &none     &none      &none          &none  &none  &none            &none  &none  &none
            >;
        };
    };
};
